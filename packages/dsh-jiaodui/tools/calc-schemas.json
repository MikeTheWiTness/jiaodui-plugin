{
  "operations": {
    "evaluate": {
      "description": "求值一个符号数学表达式，可选代入变量后进行数值计算。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "待求值的数学表达式，如 '2*x + 3*y' 或 'sqrt(u**2 + 2*a*s)'"
          },
          "substitutions": {
            "type": "object",
            "additionalProperties": true,
            "description": "变量替换映射，如 {'x': 2, 'y': 'pi/2'}；字符串值先经 sympify 解析"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "simplify": {
      "description": "对表达式化简、展开、因式分解或三角化简。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "待化简/展开的表达式，如 '(x+1)**2' 或 'sin(x)**2 + cos(x)**2'"
          },
          "method": {
            "type": "string",
            "description": "操作类型：simplify / expand / factor / trigsimp",
            "default": "simplify"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "solve": {
      "description": "求解一个或多个方程（等号形式或设为 0 的表达式）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "equations": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "方程列表，如 ['x**2 - 4 = 0'] 或 ['x + y - 5']"
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "求解的变量列表，如 ['x'] 或 ['x', 'y']"
          },
          "domain": {
            "type": "string",
            "description": "求解域：'real'（默认，剔除复数根）或 'complex'",
            "default": "real"
          }
        },
        "required": [
          "equations",
          "variables"
        ]
      }
    },
    "equality": {
      "description": "检查两个数学表达式是否等价（simplify(a-b)==0 加浮点容差）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression_a": {
            "type": "string",
            "description": "第一个表达式，如 'sin(x)**2 + cos(x)**2'"
          },
          "expression_b": {
            "type": "string",
            "description": "第二个表达式，如 '1'"
          }
        },
        "required": [
          "expression_a",
          "expression_b"
        ]
      }
    },
    "differentiate": {
      "description": "对表达式求（高阶）导数。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "被求导的表达式，如 'x**3 + 2*x'"
          },
          "variable": {
            "type": "string",
            "description": "求导变量名，如 'x'",
            "default": "x"
          },
          "order": {
            "type": "integer",
            "description": "求导阶数（正整数）",
            "default": 1
          },
          "substitutions": {
            "type": "object",
            "additionalProperties": true,
            "description": "求导后代入的变量映射（模板契约保留；旧仓未在求导前展开）"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "integrate": {
      "description": "对表达式求不定积分或定积分。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "被积表达式，如 'x**2'"
          },
          "variable": {
            "type": "string",
            "description": "积分变量名，如 'x'",
            "default": "x"
          },
          "lower_limit": {
            "type": "string",
            "description": "定积分下限表达式（与 upper_limit 同时给出时才做定积分），如 '0'"
          },
          "upper_limit": {
            "type": "string",
            "description": "定积分上限表达式，如 'pi/2'"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "formula": {
      "description": "从物理公式中解出目标变量，可选代入已知数值。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "formula": {
            "type": "string",
            "description": "物理公式（等号形式），如 'v = u + a*t' 或 'E = 1/2 * m * v**2'"
          },
          "solve_for": {
            "type": "string",
            "description": "要解出的目标变量名，如 'a' 或 'v'"
          },
          "substitutions": {
            "type": "object",
            "additionalProperties": true,
            "description": "已知量数值映射，如 {'v': 20, 'u': 0, 't': 5}"
          }
        },
        "required": [
          "formula",
          "solve_for"
        ]
      }
    },
    "dimensional": {
      "description": "量纲分析：等号两侧一致性 / 提取量纲 / 单位换算。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "物理表达式，如 'F = m * a' 或 'F = B**2*L**2*v/(R+r)'"
          },
          "dim_operation": {
            "type": "string",
            "description": "操作：check_consistency / get_dimensions / convert",
            "default": "check_consistency"
          },
          "unit_definitions": {
            "type": "object",
            "additionalProperties": true,
            "description": "表达式里每个符号的声明，三种形态：单位表达式 {'F': 'newton'}；显式量纲 {'F': 'dim:M*L*T**-2'}（只允许 M/L/T/I/Θ/N/J）；物理量名+单位 {'F': {'quantity': '力', 'unit': 'newton'}}。无量纲写 'dimensionless'；候选列表表示调用方显式列出的全部候选读数，工具会枚举所有组合并回报全部自洽解（{'V': ['meter/second', 'meter**3']}）"
          },
          "target_units": {
            "type": "string",
            "description": "目标单位表达式，仅 dim_operation='convert' 时使用，如 'kilometer / hour'",
            "default": ""
          },
          "quantities": {
            "type": "object",
            "additionalProperties": true,
            "description": "学科物理量表 {物理量名: 单位表达式}，由宿主按 --subject 注入；只用于给 quantity 声明做量纲交叉校验（内部参数）"
          }
        },
        "required": [
          "expression",
          "unit_definitions"
        ]
      }
    },
    "limit": {
      "description": "计算表达式的极限（双侧或单侧）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "求极限的表达式，如 'sin(x)/x'"
          },
          "variable": {
            "type": "string",
            "description": "趋近变量，如 'x'"
          },
          "approach": {
            "type": "string",
            "description": "趋近值，如 '0' 或 'oo'"
          },
          "direction": {
            "type": "string",
            "description": "方向：'+' 右极限，'-' 左极限，'+-' 双侧",
            "default": "+-"
          }
        },
        "required": [
          "expression",
          "variable",
          "approach"
        ]
      }
    },
    "geometry": {
      "description": "几何构造与测量（点、线、圆、垂线、中点、距离、夹角、交点）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expression": {
            "type": "string",
            "description": "几何表达式，可链式调用，如 'Point(0,0).distance(Point(3*h,4*h))' 或 'Circle(Point(0,0), 5).intersection(Line(Point(-10,3), Point(10,3)))'"
          }
        },
        "required": [
          "expression"
        ]
      }
    },
    "vector_ops": {
      "description": "向量运算：点积、叉积（2D/3D）、夹角、投影。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vector_operation": {
            "type": "string",
            "description": "向量操作：'dot' / 'cross' / 'angle' / 'projection'"
          },
          "vec_a": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "向量 A 的坐标，如 [1, 2, 3]"
          },
          "vec_b": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "向量 B 的坐标，如 [4, 5, 6]"
          }
        },
        "required": [
          "vector_operation",
          "vec_a",
          "vec_b"
        ]
      }
    },
    "circle_from_two_points": {
      "description": "由两点及其方向/法向量求解圆的圆心与半径。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entry_point": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "第一个点的坐标，如 ['1.5*h', 'h']（支持符号表达式）"
          },
          "velocity_direction": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "第一个点处的方向向量（切线方向），如 [3, 4]（无需归一化）"
          },
          "impact_point": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "第二个点的坐标，如 ['0', '-1.5*h']"
          },
          "impact_normal": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "第二个点处的法向量，如 [0, 1]"
          }
        },
        "required": [
          "entry_point",
          "velocity_direction",
          "impact_point",
          "impact_normal"
        ]
      }
    },
    "chemistry_balance": {
      "description": "配平化学方程式（原子守恒矩阵求零空间）。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "equation": {
            "type": "string",
            "description": "待配平的化学方程式，用 -> 分隔，如 'Fe + O2 -> Fe2O3'"
          }
        },
        "required": [
          "equation"
        ]
      }
    },
    "stoichiometry": {
      "description": "由已配平方程式与一种物质质量计算另一种物质的质量。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "balanced_equation": {
            "type": "string",
            "description": "已配平的化学方程式，如 '2H2 + O2 -> 2H2O'"
          },
          "known_substance": {
            "type": "string",
            "description": "已知质量的物质化学式，如 'H2'"
          },
          "known_mass": {
            "type": "number",
            "description": "已知物质的质量，单位克(g)，如 4.0"
          },
          "target_substance": {
            "type": "string",
            "description": "待求质量的物质化学式，如 'H2O'"
          }
        },
        "required": [
          "balanced_equation",
          "known_substance",
          "known_mass",
          "target_substance"
        ]
      }
    }
  }
}
