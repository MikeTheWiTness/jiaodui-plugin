{
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "body_sha256",
      "corrections",
      "evidence",
      "proposal_revision",
      "run_id",
      "schema_version",
      "self_check",
      "source_sha256",
      "summary",
      "task_id",
      "unit_id"
    ],
    "properties": {
      "schema_version": {
        "type": "integer",
        "const": 2
      },
      "task_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "unit_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "run_id": {
        "type": "string",
        "minLength": 1
      },
      "source_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "body_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "proposal_revision": {
        "type": "integer",
        "minimum": 1
      },
      "summary": {
        "type": "string",
        "enum": [
          "无问题",
          "轻微问题",
          "一般问题",
          "严重错误"
        ]
      },
      "corrections": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "evidence_ids",
            "expected_original",
            "id",
            "location_id",
            "reason",
            "replacement",
            "severity"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "location_id": {
              "type": "string",
              "minLength": 1
            },
            "expected_original": {
              "type": "string",
              "minLength": 1
            },
            "replacement": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": [
                "一般问题",
                "严重错误",
                "轻微问题"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "evidence": {
        "type": "object",
        "additionalProperties": true
      },
      "self_check": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "checks",
          "unresolved"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "needs_user"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
