{
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "body_sha256",
      "corrections",
      "evidence",
      "proposal_revision",
      "run_id",
      "schema_version",
      "self_check",
      "source_sha256",
      "summary",
      "task_id",
      "unit_id"
    ],
    "properties": {
      "schema_version": {
        "type": "integer",
        "const": 2
      },
      "task_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "unit_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$"
      },
      "run_id": {
        "type": "string",
        "minLength": 1
      },
      "source_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "body_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "proposal_revision": {
        "type": "integer",
        "minimum": 1
      },
      "summary": {
        "type": "string",
        "enum": [
          "无问题",
          "轻微问题",
          "一般问题",
          "严重错误"
        ]
      },
      "corrections": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "category",
            "evidence_ids",
            "expected_original",
            "id",
            "location_id",
            "reason",
            "replacement",
            "severity"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "location_id": {
              "type": "string",
              "minLength": 1
            },
            "expected_original": {
              "type": "string",
              "minLength": 1
            },
            "replacement": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "enum": [
                "一般问题",
                "严重错误",
                "轻微问题"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assumptions",
          "symbols",
          "images",
          "calculations"
        ],
        "properties": {
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "source_locations"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_locations": {
                  "type": "array"
                }
              }
            }
          },
          "symbols": {
            "type": "array"
          },
          "images": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "reference_index",
                    "original_path",
                    "actual_read_path",
                    "position",
                    "readable",
                    "semantic",
                    "verdict"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reference_index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "original_path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "actual_read_path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "position": {
                      "type": "object",
                      "required": [
                        "line",
                        "column"
                      ],
                      "properties": {
                        "line": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "column": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    },
                    "readable": {
                      "type": "boolean"
                    },
                    "semantic": {
                      "type": "string"
                    },
                    "verdict": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "not_applicable"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "calculations": {
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "call_id",
                    "expression",
                    "result"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "call_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "expression": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {}
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "reason"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "const": "not_applicable"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      },
      "self_check": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "checks",
          "unresolved"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "passed"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "no_issue_review",
                "real_issue",
                "related_coverage",
                "replacement_semantics",
                "scope_and_uncertainty",
                "severity"
              ]
            }
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
